<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE func-lib PUBLIC "-//Railo//DTD CFML Function Library 1.0//EN"
	"dtd/web-cfmfunctionlibrary_1_0.dtd">
<!-- http://www.getrailo.com/j2ee/dtd/web-jspfunctionlibrary_1_0.dtd -->
<func-lib>
	<flib-version>1.00</flib-version>
	<short-name>PDF</short-name>
	<uri>http://extension.lucee.org/function/pdf</uri>
	<display-name>PDF</display-name>
	<description>
		Functions to interact with PDF
	</description>

	
	<!-- IsPDFFile -->
	<function>
		<name>IsPDFFile</name>
		<class maven="{maven}">org.lucee.extension.pdf.function.IsPDFFile</class>
		<status>unimplemeted</status>
		<keywords>decision,pdf</keywords>
		<description>Verifies whether a PDF file is valid.</description>
		<argument>
			<name>path</name>
			<alias>file,value</alias>
			<type>string</type>
			<required>Yes</required>
		<description>Pathname to a PDF file. The pathname can be absolute or relative to the CFM page and must be enclosed in quotation marks.</description>
    </argument>
		<return>
			<type>boolean</type>
		</return>
	</function>
	<!-- IsPDFArchive -->
	<function>
		<name>IsPDFArchive</name>
		<class maven="{maven}">org.lucee.extension.pdf.function.IsPDFArchive</class>
		<keywords>decision,pdf</keywords>
		<description>Checks whether a PDF file declares PDF/A conformance via XMP metadata.</description>
		<argument>
			<name>path</name>
			<alias>file,value</alias>
			<type>string</type>
			<required>Yes</required>
			<description>Pathname to a PDF file.</description>
		</argument>
		<return>
			<type>boolean</type>
		</return>
	</function>
	<!-- IsPDFObject -->
	<function>
		<name >IsPDFObject</name>
		<class maven="{maven}">org.lucee.extension.pdf.function.IsPDFObject</class>
		<keywords>decision,pdf</keywords>
		<description>Determines whether a value is a PDF object.</description>
		<argument>
			<name>value</name>
			<type>any</type>
			<required>Yes</required>
		<description>A value, typically the PDF object stored as a variable name.</description>
    </argument>
		<return>
			<type>boolean</type>
		</return>
	</function>

	<!-- GetPDFLinkURIs -->
	<function>
		<name>GetPDFLinkURIs</name>
		<class maven="{maven}">org.lucee.extension.pdf.function.GetPDFLinkURIs</class>
		<keywords>pdf,link</keywords>
		<description>Returns URI strings from Link annotations in a PDF file.</description>
		<argument>
			<name>path</name>
			<type>string</type>
			<required>Yes</required>
			<description>Path to a PDF file.</description>
		</argument>
		<return>
			<type>array</type>
		</return>
	</function>

	<!-- CountPDFLinkAnnotations -->
	<function>
		<name>CountPDFLinkAnnotations</name>
		<class maven="{maven}">org.lucee.extension.pdf.function.CountPDFLinkAnnotations</class>
		<keywords>pdf,link</keywords>
		<description>Returns the count of Link annotations across all pages in a PDF file.</description>
		<argument>
			<name>path</name>
			<type>string</type>
			<required>Yes</required>
			<description>Path to a PDF file.</description>
		</argument>
		<return>
			<type>numeric</type>
		</return>
	</function>

	<!-- GetPDFFontNamesList -->
	<function>
		<name>GetPDFFontNamesList</name>
		<class maven="{maven}">org.lucee.extension.pdf.function.GetPDFFontNamesList</class>
		<keywords>pdf,font</keywords>
		<description>Returns embedded font names from a PDF file as a comma-separated list.</description>
		<argument>
			<name>path</name>
			<type>string</type>
			<required>Yes</required>
			<description>Path to a PDF file.</description>
		</argument>
		<return>
			<type>string</type>
		</return>
	</function>
	
	
</func-lib>
